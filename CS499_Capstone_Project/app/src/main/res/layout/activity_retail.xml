<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retail"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#1A1A1A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnViewCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Cart (0 items)"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPurchaseMembership"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Purchase Membership"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPurchaseGear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Purchase Training Gear"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPurchaseDrinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Purchase Drinks"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReturnFromRetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Return to Main Menu" />

    </LinearLayout>
</LinearLayout>