<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Payment Method"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#1A1A1A" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/editNameOnCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name on Card"
                android:textColor="#FFFFFF"
                android:inputType="textPersonName"
                android:background="#2A2A2A"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editCardNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Card Number"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:maxLength="16"
                android:background="#2A2A2A"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editExpiration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Expiration Date (MM/YY)"
                android:textColor="#FFFFFF"
                android:inputType="text"
                android:maxLength="5"
                android:background="#2A2A2A"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/editSecurityCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Security Code"
                android:textColor="#FFFFFF"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:background="#2A2A2A"
                android:padding="14dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnBackFromAddPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Profile" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>